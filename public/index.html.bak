<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Pathways Console</title>
<meta name="robots" content="noindex,nofollow">
<style>
  :root{
    --base:#020501; --deep:#153009; --gold:#CBB26A; --som:#D3B127;
    --ink:#e6e2d8; --dim:#8f9a86; --line:#1d3a0c;
  }
  *{box-sizing:border-box}
  html,body{height:100%}
  body{
    margin:0; background:var(--base); color:var(--ink);
    font:400 15px/1.55 "Helvetica Neue",Arial,sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .app{display:flex; height:100dvh; overflow:hidden}

  /* ---------- side rail ---------- */
  .rail{
    width:264px; flex:0 0 264px; background:var(--deep);
    border-right:1px solid var(--line);
    display:flex; flex-direction:column; overflow:hidden;
  }
  .rail h1{margin:0; padding:18px 16px 10px}
  .rail h1 img{display:block; width:112px; height:auto; margin:0 auto}
  .rail .sub{color:var(--dim); font-size:11.5px; padding:0 18px 16px; border-bottom:1px solid var(--line)}
  .seats{flex:1; overflow-y:auto; padding:8px 0}
  .seat{
    display:flex; align-items:center; gap:11px; width:100%;
    padding:8px 14px; background:none; border:0; border-left:3px solid transparent;
    color:var(--ink); text-align:left; cursor:pointer; font:inherit;
  }
  .seat:hover{background:rgba(203,178,106,.06)}
  .seat:focus-visible{outline:2px solid var(--som); outline-offset:-2px}
  .seat[aria-current="true"]{border-left-color:var(--gold); background:rgba(203,178,106,.09)}
  .face{
    width:80px;height:80px;flex:0 0 80px;border-radius:9px;object-fit:cover;
    border:1px solid var(--line); background:#0a1206; display:block;
  }
  .seat[aria-current="true"] .face{border-color:var(--gold)}
  .seat[aria-current="true"] .face{filter:brightness(1.04)}
  .dot{
    width:8px; height:8px; border-radius:50%; flex:0 0 8px; background:#3b4a33;
  }
  .seat[data-live="1"] .dot{background:var(--som)}
  .seat .nm{font-weight:600; font-size:14px}
  .seat .ti{color:var(--dim); font-size:11.5px; display:block; line-height:1.3}
  .rail footer{padding:12px 18px; border-top:1px solid var(--line); color:var(--dim); font-size:11px}

  /* ---------- main ---------- */
  main{flex:1; display:flex; flex-direction:column; min-width:0}
  header.top{
    display:flex; align-items:baseline; gap:10px;
    padding:16px 22px; border-bottom:1px solid var(--line); flex-wrap:wrap;
  }
  header.top .who{font:600 17px/1.2 Georgia,serif; color:var(--gold)}
  header.top .role{color:var(--dim); font-size:12.5px}
  header.top .right{margin-left:auto; display:flex; gap:8px}
  header.top button{
    background:none; border:1px solid var(--line); color:var(--dim);
    border-radius:7px; padding:5px 11px; font:500 12px/1 Arial,sans-serif; cursor:pointer;
  }
  header.top button:hover{color:var(--gold); border-color:var(--gold)}

  #log{flex:1; overflow-y:auto; padding:22px; display:flex; flex-direction:column; gap:14px; scroll-behavior:smooth}
  .msg{width:fit-content; max-width:min(760px,92%); border-radius:12px; padding:14px 18px; word-wrap:break-word; overflow-wrap:anywhere}
  /* A seat reply reads as a document: the bubble takes the width it needs up to the cap, lines run
     to the measure, and the label sits with the text rather than floating in the margin. */
  .msg.seat{width:min(760px,92%)}
  .msg>*{max-width:100%}
  .msg p, .msg li{text-wrap:pretty}
  .msg blockquote{margin:10px 0; padding:4px 0 4px 14px}
  .msg ul,.msg ol{margin:8px 0 12px; padding-left:22px}
  .msg h1,.msg h2,.msg h3,.msg h4{text-wrap:balance}
  .msg.user{white-space:pre-wrap}
  /* Rendered markdown. The seats write in headings and bold; this is what turns the marks
     into typography instead of showing them to the reader. */
  .msg h1,.msg h2,.msg h3,.msg h4{margin:14px 0 6px; line-height:1.25; color:var(--gold); font-weight:600}
  .msg h1{font-size:18px; letter-spacing:.01em}
  .msg h2{font-size:16.5px}
  .msg h3{font-size:15px}
  .msg h4{font-size:13.5px; color:var(--som); text-transform:none}
  .msg h1:first-child,.msg h2:first-child,.msg h3:first-child,.msg h4:first-child{margin-top:2px}
  .msg p{margin:0 0 9px}
  .msg p:last-child{margin-bottom:0}
  .msg ul,.msg ol{margin:6px 0 10px; padding-left:20px}
  .msg li{margin:0 0 4px}
  .msg blockquote{margin:8px 0; padding:2px 0 2px 12px; border-left:2px solid var(--gold); color:#d8d2c4}
  .msg hr{border:0; border-top:1px solid var(--line); margin:12px 0}
  .msg code{font:12px/1.4 "SF Mono",Menlo,Consolas,monospace; background:#131a0f; border:1px solid var(--line); padding:1px 4px; border-radius:3px}
  .msg strong{font-weight:600; color:#f2eee4}
  .msg em{font-style:italic}
  .msg.user{align-self:flex-end; background:#22201c; border:1px solid #33302a}
  .msg.seat{align-self:flex-start; background:#0a1206; border:1px solid var(--line)}
  .msg.err{align-self:flex-start; background:#2a1414; border:1px solid #4a2020; color:#e8c8c8}
  .msg .lbl{display:block; position:static; font:600 10.5px/1 Arial,sans-serif; letter-spacing:.1em;
    text-transform:uppercase; color:var(--dim); margin:0 0 9px; max-width:100%}
  .empty{margin:auto; text-align:center; color:var(--dim); max-width:520px}
  .empty h2{font:600 20px/1.3 Georgia,serif; color:var(--gold); margin:0 0 10px}
  .empty-logo{display:block; width:172px; height:auto; margin:0 auto 18px; opacity:.95}

  form.compose{display:flex; gap:10px; padding:16px 22px; border-top:1px solid var(--line)}
  form.compose textarea{
    flex:1; resize:none; height:52px; max-height:180px; overflow-y:auto;
    background:#0a1206; border:1px solid var(--line); border-radius:9px;
    color:var(--ink); padding:15px 14px; font:400 14.5px/1.4 inherit;
  }
  form.compose textarea:focus{outline:2px solid var(--som); outline-offset:1px}
  form.compose button{
    background:var(--som); color:var(--base); border:0; border-radius:9px;
    padding:0 20px; font:600 14px/1 inherit; cursor:pointer;
  }
  form.compose button[disabled]{opacity:.45; cursor:default}

  /* ---------- records ---------- */
  #recordsPanel{flex:1; display:flex; flex-direction:column; min-height:0; background:var(--base)}
  #recordsPanel[hidden]{display:none}
  .rec-head{display:flex; align-items:baseline; gap:10px; padding:14px 22px; border-bottom:1px solid var(--line); flex-wrap:wrap}
  .rec-head .right{margin-left:auto; display:flex; gap:8px}
  .rec-head button{background:none;border:1px solid var(--line);color:var(--dim);border-radius:7px;
    padding:5px 11px;font:500 12px/1 Arial,sans-serif;cursor:pointer}
  .rec-head button:hover{color:var(--gold);border-color:var(--gold)}
  .rec-body{flex:1; display:flex; min-height:0}
  #recFiles{list-style:none; margin:0; padding:10px 0; width:210px; flex:0 0 210px;
    border-right:1px solid var(--line); overflow-y:auto}
  #recFiles li button{display:block;width:100%;text-align:left;background:none;border:0;color:var(--ink);
    padding:9px 16px;cursor:pointer;font:400 13px/1.3 inherit}
  #recFiles li button:hover{background:rgba(203,178,106,.07);color:var(--gold)}
  #recFiles li button[aria-current="true"]{color:var(--gold);border-left:3px solid var(--gold)}
  #recDoc{flex:1; overflow-y:auto; margin:0; padding:20px 24px;
    font:400 13.5px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace; color:var(--ink)}
  .rec-empty{color:var(--dim); padding:20px 16px; font-size:13px}
  @media (max-width:760px){
    .rec-body{flex-direction:column}
    #recFiles{width:auto;flex:0 0 auto;max-height:200px;border-right:0;border-bottom:1px solid var(--line)}
  }

  /* ---------- mobile brand ---------- */
  .mob-brand{display:none}
  @media (max-width:760px){
    .mob-brand{display:block; background:var(--deep); padding:12px 14px 2px}
    .mob-brand img{display:block; width:132px; height:auto; margin:0 auto}
  }

  /* ---------- mobile: seat switcher ---------- */
  .switcher{display:none}
  @media (max-width:760px){
    .app{flex-direction:column}
    .rail{display:none}
    .switcher{
      display:flex; gap:8px; overflow-x:auto; padding:10px 14px;
      border-bottom:1px solid var(--line); background:var(--deep);
    }
    .switcher button{
      flex:0 0 auto; background:#0a1206; border:1px solid var(--line); color:var(--ink);
      border-radius:999px; padding:6px 14px 6px 6px; font:500 13px/1 inherit; cursor:pointer;
      display:flex; align-items:center; gap:8px;
    }
    .switcher .face{width:44px;height:44px;flex:0 0 44px;border-radius:8px}
    .switcher button[aria-current="true"]{border-color:var(--som); color:var(--gold)}
    header.top{padding:12px 16px}
    #log{padding:16px 14px}
    form.compose{padding:12px 14px; gap:8px}
  }
</style>
</head>
<body>
<div class="app">
  <nav class="rail" aria-label="Seats">
    <h1><img src="/brand/logo-mark.png" alt="Queer Pathways" width="698" height="512"></h1>
    <div class="sub">Seven seats · one brief each</div>
    <div class="seats" id="seatList"></div>
    <footer>Private. Not published anywhere.<br>Queer Pathways · clinical lane</footer>
  </nav>

  <main>
    <div class="mob-brand">
      <img src="/brand/logo-full.png" alt="Queer Pathways" width="698" height="658">
    </div>
    <div class="switcher" id="switcher" role="tablist" aria-label="Seats"></div>
    <header class="top">
      <span class="who" id="who">Pathways Console</span>
      <span class="role" id="role"></span>
      <span class="right">
        <button type="button" id="records">Records</button>
        <button type="button" id="clear">New conversation</button>
      </span>
    </header>

    <div id="log" aria-live="polite"></div>

    <section id="recordsPanel" hidden>
      <header class="rec-head">
        <strong id="recTitle">Records</strong>
        <span id="recSub" class="role"></span>
        <span class="right">
          <button type="button" id="recAdam">Adam's record</button>
          <button type="button" id="recSeat">This seat</button>
          <button type="button" id="recClose">Close</button>
        </span>
      </header>
      <div class="rec-body">
        <ul id="recFiles"></ul>
        <article id="recDoc">Choose a file on the left.</article>
      </div>
    </section>

    <form class="compose" id="compose">
      <textarea id="input" placeholder="Write to the selected seat…" aria-label="Message"></textarea>
      <button type="submit" id="send">Send</button>
    </form>
  </main>
</div>

<script>
(function(){
  "use strict";
  var SEATS = [];
  var current = null;
  var threads = {};          // seatId -> [{role,text}]
  var busy = false;

  var elSeats = document.getElementById("seatList");
  var elSwitch = document.getElementById("switcher");
  var elLog = document.getElementById("log");
  var elWho = document.getElementById("who");
  var elRole = document.getElementById("role");
  var elInput = document.getElementById("input");
  var elSend = document.getElementById("send");
  var elForm = document.getElementById("compose");
  document.getElementById("clear").addEventListener("click", function(){ if(current){ threads[current]=[]; render(); } });

  function esc(s){ return s; }

  function load(){
    fetch("/api/seats").then(function(r){ return r.json(); }).then(function(d){
      SEATS = d || [];
      if(!SEATS.length){ fail("No seats were returned. The function ran but the seat file was empty."); return; }
      buildNav();
      select(SEATS[0].id);
    }).catch(function(){ fail("Could not reach the seat list."); });
  }

  function buildNav(){
    elSeats.innerHTML = ""; elSwitch.innerHTML = "";
    SEATS.forEach(function(s){
      var b = document.createElement("button");
      b.className = "seat"; b.type = "button";
      b.dataset.id = s.id;
      var face = s.portrait
        ? '<img class="face" src="' + s.portrait + '" alt="" onerror="this.replaceWith(Object.assign(document.createElement(\'span\'),{className:\'dot\'}))">'
        : '<span class="dot"></span>';
      b.innerHTML = face + '<span><span class="nm">' + s.name + '</span>' +
                    '<span class="ti">' + (s.title || "") + '</span></span>';
      b.addEventListener("click", function(){ select(s.id); });
      elSeats.appendChild(b);

      var m = document.createElement("button");
      m.type = "button"; m.dataset.id = s.id;
      m.innerHTML = (s.portrait ? '<img class="face" src="' + s.portrait + '" alt="">' : '') + s.name;
      m.addEventListener("click", function(){ select(s.id); });
      elSwitch.appendChild(m);
    });
  }

  function select(id){
    current = id;
    var s = SEATS.filter(function(x){ return x.id === id; })[0] || {};
    elWho.textContent = s.name || "Seat";
    elRole.textContent = s.title || "";
    Array.prototype.forEach.call(document.querySelectorAll(".seat, .switcher button"), function(b){
      b.setAttribute("aria-current", b.dataset.id === id ? "true" : "false");
    });
    render();
    elInput.focus();
  }

  function thread(){ if(!threads[current]) threads[current] = []; return threads[current]; }

  function render(){
    elLog.innerHTML = "";
    var t = thread();
    if(!t.length){
      var e = document.createElement("div");
      e.className = "empty";
      e.innerHTML = '<img class="empty-logo" src="/brand/logo-full.png" alt="Queer Pathways">' +
                    "<h2>" + (elWho.textContent) + "</h2><p>Write below. Every exchange is recorded — "
                    + "this seat&rsquo;s record and Adam&rsquo;s. Nothing is lost.</p>";
      elLog.appendChild(e);
      return;
    }
    t.forEach(function(m){
      var d = document.createElement("div");
      d.className = "msg " + (m.role === "user" ? "user" : "seat");
      if(m.role !== "user"){
        var l = document.createElement("span"); l.className = "lbl"; l.textContent = elWho.textContent;
        d.appendChild(l);
      }
      var body = document.createElement("div");
      paint(body, m.text);
      d.appendChild(body);
      elLog.appendChild(d);
    });
    elLog.scrollTop = elLog.scrollHeight;
  }


  // ---- markdown, rendered rather than shown ----
  // The seats write headings, bold and lists. This is what makes the marks typography.
  // Everything is escaped BEFORE any tag is inserted, so a seat cannot inject markup.
  function esc(s){
    return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
  }
  function inl(s){
    return s
      .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
      .replace(/(^|[^*])\*([^*\n]+)\*/g, "$1<em>$2</em>")
      .replace(/`([^`]+)`/g, "<code>$1</code>");
  }
  function md(src){
    // Structure is detected on the RAW line, then each piece of text is escaped as it is
    // placed. Escaping first would turn a ">" blockquote into "&gt;" and lose the marker.
    var lines = String(src).split("\n");
    var out = [], list = null, para = [];
    function flushPara(){ if(para.length){ out.push("<p>" + inl(esc(para.join(" "))) + "</p>"); para = []; } }
    function closeList(){ if(list){ out.push("</" + list + ">"); list = null; } }
    for(var i = 0; i < lines.length; i++){
      var t = lines[i].trim(), m;
      if(!t){ flushPara(); closeList(); continue; }
      if((m = t.match(/^(#{1,4})\s+(.*)$/))){
        flushPara(); closeList();
        out.push("<h" + m[1].length + ">" + inl(esc(m[2])) + "</h" + m[1].length + ">"); continue;
      }
      if(/^(-{3,}|\*{3,}|_{3,})$/.test(t)){ flushPara(); closeList(); out.push("<hr>"); continue; }
      if((m = t.match(/^>\s?(.*)$/))){ flushPara(); closeList(); out.push("<blockquote>" + inl(esc(m[1])) + "</blockquote>"); continue; }
      if((m = t.match(/^[-*+]\s+(.*)$/))){
        flushPara(); if(list !== "ul"){ closeList(); out.push("<ul>"); list = "ul"; }
        out.push("<li>" + inl(esc(m[1])) + "</li>"); continue;
      }
      if((m = t.match(/^(\d+)[.)]\s+(.*)$/))){
        flushPara(); if(list !== "ol"){ closeList(); out.push("<ol>"); list = "ol"; }
        out.push("<li>" + inl(esc(m[2])) + "</li>"); continue;
      }
      closeList(); para.push(t);
    }
    flushPara(); closeList();
    return out.join("");
  }
  function paint(el, text){ el.innerHTML = md(text); }

  function add(role, text){
    thread().push({ role: role, text: text });
    var t = thread();
    var d = document.createElement("div");
    d.className = "msg " + (role === "user" ? "user" : "seat");
    if(role !== "user"){ var l = document.createElement("span"); l.className="lbl"; l.textContent = elWho.textContent; d.appendChild(l); }
    if(role === "user"){ d.appendChild(document.createTextNode(text)); }
    else { var body = document.createElement("div"); paint(body, text); d.appendChild(body); }
    var empty = elLog.querySelector(".empty"); if(empty) elLog.innerHTML = "";
    elLog.appendChild(d);
    elLog.scrollTop = elLog.scrollHeight;
  }

  function send(){
    var text = elInput.value.trim();
    if(!text || busy || !current) return;
    elInput.value = "";
    add("user", text);
    busy = true; elSend.disabled = true;
    var pending = document.createElement("div");
    pending.className = "msg seat"; pending.textContent = "…";
    elLog.appendChild(pending); elLog.scrollTop = elLog.scrollHeight;

    fetch("/api/chat", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ seatId: current, messages: thread() })
    })
    .then(function(r){ return r.json().catch(function(){ return {}; }); })
    .then(function(d){
      if(d && d.reply){
        pending.remove();
        add("seat", d.reply);
      } else {
        pending.className = "msg err";
        pending.textContent = (d && d.message) || "That did not come back. Nothing was saved.";
      }
    })
    .catch(function(){
      pending.className = "msg err";
      pending.textContent = "Could not reach the server. Nothing was saved.";
    })
    .then(function(){ busy = false; elSend.disabled = false; elInput.focus(); });
  }

  elForm.addEventListener("submit", function(e){ e.preventDefault(); send(); });
  elInput.addEventListener("keydown", function(e){
    if(e.key === "Enter" && !e.shiftKey){ e.preventDefault(); send(); }
  });

  /* ---------------- records ---------------- */
  var panel = document.getElementById("recordsPanel");
  var mainLog = document.getElementById("log");
  var compose = document.getElementById("compose");
  var recFiles = document.getElementById("recFiles");
  var recDoc = document.getElementById("recDoc");
  var recTitle = document.getElementById("recTitle");
  var recSub = document.getElementById("recSub");
  var recMode = "seat";

  function showRecords(on){
    panel.hidden = !on;
    mainLog.style.display = on ? "none" : "";
    compose.style.display = on ? "none" : "";
    if(on) loadRecords();
  }
  document.getElementById("records").addEventListener("click", function(){ showRecords(panel.hidden); });
  document.getElementById("recClose").addEventListener("click", function(){ showRecords(false); });
  document.getElementById("recAdam").addEventListener("click", function(){ recMode = "adam"; loadRecords(); });
  document.getElementById("recSeat").addEventListener("click", function(){ recMode = "seat"; loadRecords(); });

  function loadRecords(){
    recFiles.innerHTML = ""; recDoc.textContent = "";
    var url = recMode === "adam" ? "/api/transcripts?list=adam" : "/api/transcripts?seat=" + current;
    fetch(url).then(function(r){ return r.json(); }).then(function(d){
      recTitle.textContent = recMode === "adam" ? "Adam's record — every exchange" : "Record — " + elWho.textContent;
      recSub.textContent = (d.files && d.files.length) ? d.files.length + " file(s)" : "nothing recorded yet";
      if(!d.files || !d.files.length){
        var li = document.createElement("div"); li.className = "rec-empty";
        li.textContent = "No exchanges recorded yet. They appear here as you talk to the seats.";
        recFiles.appendChild(li); recDoc.textContent = ""; return;
      }
      d.files.slice().reverse().forEach(function(f){
        var li = document.createElement("li");
        var b = document.createElement("button");
        b.type = "button"; b.textContent = f;
        b.addEventListener("click", function(){ openRecord(f, b); });
        li.appendChild(b); recFiles.appendChild(li);
      });
    }).catch(function(){
      recDoc.textContent = "Could not load the records.";
    });
  }

  function openRecord(file, btn){
    Array.prototype.forEach.call(recFiles.querySelectorAll("button"), function(x){ x.removeAttribute("aria-current"); });
    if(btn) btn.setAttribute("aria-current","true");
    var url = recMode === "adam"
      ? "/api/transcripts?adam=1&file=" + encodeURIComponent(file)
      : "/api/transcripts?seat=" + current + "&file=" + encodeURIComponent(file);
    recDoc.textContent = "Loading…";
    fetch(url).then(function(r){ return r.text(); }).then(function(t){ paint(recDoc, t); recDoc.scrollTop = 0; });
  }

  load();
})();
</script>
</body>
</html>
